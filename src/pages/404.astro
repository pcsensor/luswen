---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" description="这个页面不存在，或已经移动。" canonicalPath="/404/" noindex>
  <section class="shell grid min-h-[65svh] place-items-center py-20 text-center">
    <div>
      <p class="eyebrow mb-6">Error / 404</p>
      <h1 class="text-[clamp(4rem,14vw,10rem)] font-medium leading-none tracking-[-.07em]">走到边界了。</h1>
      <p class="mx-auto mt-7 max-w-lg text-lg leading-8 text-[var(--muted)]">这个页面不存在，或者已经换了位置。</p>
      <div class="mt-10 flex flex-wrap justify-center gap-6 text-sm">
        <a class="border-b border-[var(--ink)] pb-1 hover:border-[var(--accent)] hover:text-[var(--accent)]" href="/">返回首页</a>
        <a class="border-b border-[var(--ink)] pb-1 hover:border-[var(--accent)] hover:text-[var(--accent)]" href="/archive/">浏览归档</a>
      </div>
    </div>
  </section>
</BaseLayout>
