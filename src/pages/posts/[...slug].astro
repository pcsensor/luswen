---
import PostLayout from "@/layouts/PostLayout.astro";
import { getAdjacentPosts, getPublishedPosts } from "@/lib/posts";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
const { newer, older } = getAdjacentPosts(posts, post.id);
---

<PostLayout post={post} newer={newer} older={older}>
  <Content />
</PostLayout>
