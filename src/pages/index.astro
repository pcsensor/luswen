---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<BaseLayout>
  <section class="shell grid min-h-[66vh] items-end gap-12 border-b rule py-16 md:grid-cols-[1fr_18rem] md:py-24">
    <div>
      <p class="eyebrow mb-7">Issue 001 · 2026</p>
      <h1 class="max-w-4xl text-[clamp(3.4rem,10vw,8.6rem)] font-semibold leading-[.82] tracking-[-.065em]">
        思考，构建，<span class="text-[var(--accent)]">保持好奇。</span>
      </h1>
    </div>
    <p class="max-w-sm text-lg leading-8 text-[var(--muted)] md:pb-2">
      一份关于设计、工程与数字生活的独立刊物。写下那些值得被慢慢理解的事。
    </p>
  </section>

  <section id="articles" class="shell py-14 md:py-20">
    <div class="mb-10 flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-3">Latest writing</p>
        <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">最近文章</h2>
      </div>
      <span class="text-sm text-[var(--muted)]">{posts.length} 篇笔记</span>
    </div>

    <div class="border-b rule">
      {posts.map((post) => (
        <a href={`/posts/${post.id}/`} class="group grid gap-5 border-t rule py-8 transition-colors hover:border-[var(--accent)] md:grid-cols-[7rem_1fr_auto] md:items-start">
          <p class="font-mono text-xs text-[var(--muted)]">{formatDate(post.data.published)}</p>
          <div>
            <p class="mb-3 text-xs font-semibold tracking-widest text-[var(--accent)] uppercase">{post.data.category}</p>
            <h3 class="text-2xl font-semibold tracking-tight transition-colors group-hover:text-[var(--accent)] md:text-3xl">{post.data.title}</h3>
            <p class="mt-3 max-w-2xl leading-7 text-[var(--muted)]">{post.data.description}</p>
          </div>
          <span class="text-2xl transition-transform group-hover:translate-x-1" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="shell grid gap-10 border-t rule py-16 md:grid-cols-[1fr_2fr] md:py-24">
    <p class="eyebrow">About this journal</p>
    <div>
      <h2 class="max-w-3xl text-3xl font-semibold leading-tight tracking-tight md:text-5xl">在技术的速度之外，保留一点判断与耐心。</h2>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--muted)]">边界笔记关注设计如何影响行为、工具如何塑造思考，以及我们怎样与不断变化的技术相处。通常两周更新一次。</p>
    </div>
  </section>
</BaseLayout>
