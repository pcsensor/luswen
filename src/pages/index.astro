---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<BaseLayout>
  <section class="shell grid min-h-[calc(100svh-4.5rem)] items-center gap-8 border-b rule py-12 md:grid-cols-[1.1fr_.9fr] md:py-18">
    <div class="relative z-10 py-8 md:py-12">
      <p class="eyebrow mb-8">Independent journal · N°001</p>
      <h1 class="max-w-3xl text-[clamp(3.4rem,8.3vw,7.4rem)] font-medium leading-[.91] tracking-[-.065em] [text-wrap:balance]">
        观察，思考，<br /><span class="text-[var(--accent)]">然后写下。</span>
      </h1>
      <p class="mt-9 max-w-xl text-lg leading-8 text-[var(--muted)]">
        关于设计、工程与数字生活的独立笔记。<br class="hidden sm:block" />记录那些值得被慢慢理解的事。
      </p>
      <a href="#articles" class="mt-10 inline-flex items-center gap-4 border-b border-[var(--ink)] pb-2 font-mono text-xs tracking-[.16em] uppercase transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]">
        开始阅读 <span aria-hidden="true">↓</span>
      </a>
    </div>

    <figure class="corner-frame mx-auto flex h-[34rem] w-full max-w-[28rem] items-center justify-center p-8 md:h-[39rem]">
      <img class="botanical-illustration h-full w-full object-contain" src="/botanical-study.png" alt="铅笔绘制的野花植物标本" width="1024" height="1536" />
      <figcaption class="absolute right-7 bottom-5 bg-[var(--page)] px-3 py-1 font-mono text-[10px] tracking-[.15em] text-[var(--muted)] uppercase">
        specimen 01 / field notes
      </figcaption>
    </figure>
  </section>

  <section id="articles" class="shell scroll-mt-24 py-16 md:py-24">
    <div class="mb-12 flex items-end justify-between gap-6 border-b rule pb-6">
      <div>
        <p class="eyebrow mb-3">Archive / 归档</p>
        <h2 class="text-3xl font-medium tracking-tight md:text-4xl">最近文章</h2>
      </div>
      <span class="font-mono text-xs tracking-wider text-[var(--muted)]">{String(posts.length).padStart(2, "0")} entries</span>
    </div>

    <div class="grid gap-px overflow-hidden border rule bg-[var(--line)] md:grid-cols-2">
      {posts.map((post, index) => (
        <a href={`/posts/${post.id}/`} class:list={["group paper-panel relative flex min-h-[23rem] flex-col p-7 transition-colors hover:bg-[var(--paper)] md:p-9", index === 0 && "md:col-span-2 md:min-h-[27rem]"]}>
          <div class="flex items-start justify-between gap-4 font-mono text-[10px] tracking-[.14em] uppercase text-[var(--muted)]">
            <span>0{index + 1} / {post.data.category}</span>
            <span>{formatDate(post.data.published)}</span>
          </div>
          <div class:list={["mt-auto", index === 0 && "md:grid md:grid-cols-[1fr_18rem] md:items-end md:gap-16"]}>
            <div>
              <h3 class:list={["font-medium leading-tight tracking-[-.035em] transition-colors group-hover:text-[var(--accent)]", index === 0 ? "text-4xl md:text-6xl" : "text-3xl"]}>{post.data.title}</h3>
              <p class="mt-5 max-w-xl leading-7 text-[var(--muted)]">{post.data.description}</p>
            </div>
            {index === 0 && <p class="mt-8 border-t rule pt-4 font-mono text-[10px] tracking-[.12em] text-[var(--muted)] uppercase md:mt-0">Featured note · {post.data.readingTime}</p>}
          </div>
          <span class="absolute right-7 bottom-7 text-xl opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100 md:right-9 md:bottom-9" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="shell scroll-mt-24 border-t rule py-16 md:py-24">
    <div class="grid gap-12 md:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="eyebrow">About / 关于</p>
        <p class="mt-5 font-mono text-[10px] leading-6 tracking-[.12em] text-[var(--muted)] uppercase">Design · Engineering<br />Digital life · Field notes</p>
      </div>
      <div>
        <h2 class="max-w-4xl text-3xl font-medium leading-[1.18] tracking-[-.035em] md:text-5xl">在技术的速度之外，<br />保留一点判断与耐心。</h2>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-[var(--muted)]">边界笔记关注设计如何影响行为、工具如何塑造思考，以及我们怎样与不断变化的技术相处。通常两周更新一次。</p>
      </div>
    </div>
  </section>
</BaseLayout>
