---
import RecentArticles from "@/components/RecentArticles.astro";
import { SITE } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPagePath, getPublishedPosts, POSTS_PER_PAGE } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { posts },
  }));
}

const { posts } = Astro.props;
const page = Number(Astro.params.page);
---

<BaseLayout
  title={`文章 · 第 ${page} 页`}
  description={`${SITE.name} 的文章列表，第 ${page} 页。`}
  canonicalPath={getPagePath(page)}
>
  <RecentArticles posts={posts} page={page} headingLevel="h1" />
</BaseLayout>
