---
import type { Post } from "@/lib/posts";
import { formatCompactDate, getPostPath, getReadingTime } from "@/lib/posts";

interface Props {
  post: Post;
  index?: number;
  featured?: boolean;
}

const { post, index = 0, featured = false } = Astro.props;
---

<a
  href={getPostPath(post)}
  class:list={[
    "group paper-panel relative flex min-h-[23rem] flex-col p-7 transition-colors hover:bg-[var(--paper)] focus-visible:z-10 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--accent)] md:p-9",
    featured && "md:col-span-2 md:min-h-[27rem]",
  ]}
>
  <div class="flex items-start justify-between gap-4 font-mono text-xs tracking-[.12em] uppercase text-[var(--muted)]">
    <span>{String(index + 1).padStart(2, "0")} / {post.data.category}</span>
    <time datetime={post.data.published.toISOString()}>{formatCompactDate(post.data.published)}</time>
  </div>
  <div class:list={["mt-auto", featured && "md:grid md:grid-cols-[1fr_18rem] md:items-end md:gap-16"]}>
    <div>
      <h2 class:list={["font-medium leading-tight tracking-[-.035em] transition-colors group-hover:text-[var(--accent)]", featured ? "text-4xl md:text-6xl" : "text-3xl"]}>
        {post.data.title}
      </h2>
      <p class="mt-5 max-w-xl leading-7 text-[var(--muted)]">{post.data.description}</p>
    </div>
    {featured && (
      <p class="mt-8 border-t rule pt-4 font-mono text-xs tracking-[.1em] text-[var(--muted)] uppercase md:mt-0">
        Featured note · {getReadingTime(post)}
      </p>
    )}
  </div>
  <span class="absolute right-7 bottom-7 text-xl opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100 md:right-9 md:bottom-9" aria-hidden="true">↗</span>
</a>
